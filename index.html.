<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>LTrick — Learn & Play</title>
<style>
:root{--purple:#7357e8;--pink:#ff6fae;--mint:#64d8bd;--ink:#30264d}*{box-sizing:border-box}body{margin:0;font-family:system-ui,sans-serif;background:linear-gradient(135deg,#fff5fb,#f0edff);color:var(--ink)}header,main{max-width:900px;margin:auto;padding:18px 20px}.brand{font-size:26px;font-weight:900;color:var(--purple)}.brand span{color:var(--pink)}button{border:0;border-radius:18px;padding:14px;font-weight:800;font-size:16px;cursor:pointer}.sound,.back{background:white;color:var(--purple)}.hero{display:flex;align-items:center;gap:18px;background:linear-gradient(120deg,#7659e9,#a76bf1);color:white;border-radius:26px;padding:24px}.owl{font-size:65px}.hero h1{margin:0 0 8px}.stats,.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:18px 0}.stat,.panel{background:white;border-radius:18px;padding:15px;text-align:center}.stat b{display:block;color:var(--purple);font-size:23px}.tile{min-height:120px;text-align:left;display:flex;flex-direction:column;justify-content:space-between;color:var(--ink)}.tile span{font-size:32px}.math{background:#fff0b9}.reading{background:#d9f8ee}.spell{background:#ffe0ee}.games{background:#e5ddff}.panel{text-align:left;margin-top:18px}.hidden{display:none}.question{font-size:27px;font-weight:900;text-align:center;margin:28px 0}.answers{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.answer{background:#f1edff;color:var(--purple)}.feedback{text-align:center;font-weight:800;min-height:28px;margin:15px 0}.next{background:var(--mint);width:100%}@media(max-width:500px){.hero{padding:18px}.owl{font-size:52px}}
</style></head><body>
<header><span class="brand">🦉 L<span>Trick</span></span><button class="sound" onclick="speak('Welcome to LTrick! Let’s learn and play!')">🔊 Sound</button></header>
<main><section id="home"><div class="hero"><div class="owl">🦉</div><div><h1>Ready to learn & play?</h1><p>Little lessons. Big discoveries. ⭐</p></div></div>
<div class="stats"><div class="stat"><b id="stars">⭐ 0</b>Stars</div><div class="stat"><b id="done">0</b>Lessons played</div></div><h2>Choose your adventure!</h2>
<div class="grid"><button class="tile math" onclick="start('math')"><span>🔢</span>Math Mission →</button><button class="tile reading" onclick="start('reading')"><span>📚</span>Reading Rocket →</button><button class="tile spell" onclick="start('spelling')"><span>✏️</span>Spelling Stars →</button><button class="tile games" onclick="start('games')"><span>🎮</span>Brain Games →</button></div>
<div class="panel"><b>👨‍👩‍👧 Parent corner</b><p>Progress is saved on this device. This starter version has no accounts or payments yet.</p></div></section>
<section id="lesson" class="panel hidden"><button class="back" onclick="goHome()">← Home</button><div id="lessonTitle"></div><div class="question" id="question"></div><div class="answers" id="answers"></div><div class="feedback" id="feedback"></div><button class="next hidden" id="next" onclick="nextQuestion()">Next question →</button></section></main>
<script>
let stars=+(localStorage.ltStars||0),done=+(localStorage.ltDone||0),mode='math',idx=0,questions=[];
function update(){document.getElementById('stars').textContent='⭐ '+stars;document.getElementById('done').textContent=done}
function speak(t){if('speechSynthesis'in window){speechSynthesis.cancel();let u=new SpeechSynthesisUtterance(t);u.rate=.9;speechSynthesis.speak(u)}}
function shuffle(a){return a.sort(()=>Math.random()-.5)}
function mathQ(){let a=1+Math.floor(Math.random()*10),b=1+Math.floor(Math.random()*10),v=a+b;return {q:`${a} + ${b} = ?`,ans:String(v),opts:shuffle([v,v+1,Math.max(0,v-2),v+3].map(String))}}
function readQ(){let x=[['CAT','C - A - T'],['SUN','S - U - N'],['DOG','D - O - G'],['FUN','F - U - N'],['MAP','M - A - P']][Math.floor(Math.random()*5)];return {q:`Which sounds make “${x[0]}”?`,ans:x[1],opts:shuffle([x[1],x[1].replaceAll(' - ',' '),'C - O - T','S - A - T'])}}
function spellQ(){let w=['STAR','BOOK','FISH','MOON','TREE'][Math.floor(Math.random()*5)];return {q:`Spell the word ${w.split('').join(' · ')}`,ans:w,opts:shuffle([w,w.split('').reverse().join(''),w+'S',w.slice(0,-1)])}}
function gameQ(){return {q:'Which animal is different?',ans:'🐱',opts:shuffle(['🐸','🐱','🐰','🐶'])}}
function start(m){mode=m;idx=0;questions=Array.from({length:5},()=>m==='math'?mathQ():m==='reading'?readQ():m==='spelling'?spellQ():gameQ());document.getElementById('home').classList.add('hidden');document.getElementById('lesson').classList.remove('hidden');showQ()}
function showQ(){let q=questions[idx];document.getElementById('lessonTitle').textContent=({math:'🔢 Math Mission',reading:'📚 Reading Rocket',spelling:'✏️ Spelling Stars',games:'🎮 Brain Games'})[mode]+` · ${idx+1}/5`;document.getElementById('question').textContent=q.q;document.getElementById('feedback').textContent='';document.getElementById('next').classList.add('hidden');let box=document.getElementById('answers');box.innerHTML='';q.opts.forEach(o=>{let b=document.createElement('button');b.className='answer';b.textContent=o;b.onclick=()=>check(o);box.appendChild(b)});speak(q.q)}
function check(o){let q=questions[idx],f=document.getElementById('feedback');if(o!==q.ans){f.textContent='💛 Almost! Try again.';speak('Almost. Try again!');return}f.textContent='🎉 Great job! You earned a star!';stars++;localStorage.ltStars=stars;document.querySelectorAll('.answer').forEach(b=>b.disabled=true);document.getElementById('next').classList.remove('hidden');update();speak('Great job! You earned a star!')}
function nextQuestion(){idx++;if(idx<5){showQ();return}done++;localStorage.ltDone=done;update();document.getElementById('question').textContent='🏆 Adventure complete!';document.getElementById('answers').innerHTML='';document.getElementById('feedback').textContent='You did amazing! Come back for another adventure.';let n=document.getElementById('next');n.textContent='Back to home';n.onclick=goHome;n.classList.remove('hidden');speak('Adventure complete! You did amazing!')}
function goHome(){document.getElementById('lesson').classList.add('hidden');document.getElementById('home').classList.remove('hidden');let n=document.getElementById('next');n.textContent='Next question →';n.onclick=nextQuestion;update()}
update();
</script></body></html>